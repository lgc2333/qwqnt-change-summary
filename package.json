{
  "$schema": "https://raw.githubusercontent.com/qwqnt-community/types/main/plugin.schema.json",
  "name": "qwqnt-change-summary",
  "type": "module",
  "version": "1.0.0",
  "packageManager": "pnpm@12.3.4+sha512.961aa41fb077da3a04a441d9f8e15ebc0c96da8ef710b2eb67bf9ee7cb0610eabd48f1fd85f51cffe73846785fa0f87c56a3a872a1d893f8446741b5cce45457",
  "description": "修改图片概要",
  "author": "LgCuwukii",
  "license": "MIT",
  "scripts": {
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc -b --noEmit",
    "format": "prettier -cw",
    "test": "vitest",
    "test:run": "vitest run",
    "build": "vite build --mode main && vite build --mode preload && vite build --mode renderer"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.5.1",
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@qwqnt/types": "github:qwqnt-community/types",
    "@types/node": "^26.5.1",
    "electron": "^44.3.0",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "unplugin-zip-pack": "^1.1.0",
    "vite": "^8.3.0",
    "vite-plugin-cp": "^8.0.1",
    "vitest": "^5.0.0"
  },
  "qwqnt": {
    "name": "修改图片概要",
    "inject": {
      "main": "./main/index.js",
      "preload": "./preload/index.cjs",
      "renderer": "./renderer/index.js"
    }
  }
}
